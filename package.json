{
  "name": "suanxiaozhi-refactor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx server/src/index.ts",
    "dev:full": "concurrently -n server,web -c green,blue \"pnpm dev:server\" \"pnpm dev:web\"",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server/src/index.ts",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "seed": "tsx server/src/seed.ts",
    "lint": "echo \"lint step pending: integrate eslint config\"",
    "test:ci": "vitest run --coverage --passWithNoTests --exclude tests/integration/frontend-runtime.test.ts",
    "test:runtime": "vitest run tests/integration/frontend-runtime.test.ts",
    "test:coverage": "vitest run --coverage",
    "prepare": "prisma generate --schema server/prisma/schema.prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:perf": "vitest run tests/perf",
    "test:report": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.0",
    "dompurify": "^3.2.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^12.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "ssh2": "^1.17.0",
    "tesseract.js": "^6.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "pnpm": "^11.5.1",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.8"
  }
}
